# Application
PROJECT_NAME="Smart Waste Collection Optimizer"
API_V1_STR="/api/v1"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database (Phase 2+)
DATABASE_URL=postgresql+psycopg://waste:waste@localhost:5432/waste_db

# Security & Auth (Phase 5)
SECRET_KEY="temporary-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Optimization (Phase 4)
OSRM_URL="https://router.project-osrm.org"
SOLVER_TIME_LIMIT_SECONDS=20

# AI & Maps Integration (Optional)
GEMINI_API_KEY=""
GEOAPIFY_API_KEY=""
